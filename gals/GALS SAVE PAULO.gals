#Options
GenerateScanner = true
GenerateParser = true
Language = Java
ScannerName = Lexico
ParserName = Sintatico
SemanticName = Semantico
ScannerCaseSensitive = true
ScannerTable = Full
Input = Stream
Parser = SLR
#RegularDefinitions
LETRA: [a-zA-Z_]
DIGITO: [0-9]
ESPECIAL: [^a-zA-Z]

#Tokens
//palavras reservadas
BEGIN_PROGRAM: "StandingBy"
END_PROGRAM: "Complete"
READ_INPUT: "henshin"
PRINT_OUTPUT: "riderkick"

//*************BEGIN OPERADORES**************** 
//matematica
"=" 
"+" 
"*" 
"-" 
"/"
//incremento
"++"
"+="
"--"
"-="
//delimitadores ou agrupadores
"("
")"
"{"
"}"
","
";"
//logicos
">"
">="
"<="
"=="
"!="
"!"
"||"
"&&"
"and"
"or"
//repeticao
"for"
"while"
"do"
//
"return"
//*************END OPERADORES****************

//************begin reserved*****************
"int"
"float"
"char"
"string"
"if"
"else"
//************end reserved*****************

//************begin tokens*****************
ID: {LETRA}({LETRA} | {DIGITO})*
//reconhecendo tipos
INT: {DIGITO}+
STRING: \"({LETRA}|{ESPECIAL})*\"
CHAR: '({LETRA}|{ESPECIAL})'

//************end tokens*******************

//ignore
: "#".*
: ">!"(.|\n)*"!<"
: [" "\t\r\n]+
#NonTerminals
<PROGRAMA>
<LISTA_COMANDOS>
<COMANDO>

<ATRIB>
<EXP>
<OP>
<TIPO>
<DECL>

<READ>
<WRITE>
<WRITE_CONTENT>
#Grammar
//inicio e fim do programa
<PROGRAMA> ::= BEGIN_PROGRAM <LISTA_COMANDOS> END_PROGRAM;
//lista de comandos
<LISTA_COMANDOS> ::= <COMANDO> | <LISTA_COMANDOS> <COMANDO>;
<COMANDO> ::= <ATRIB> | <READ> | <WRITE> ;

//Regra pra declaração de variavel, atribuicao e operações com variáveis.
<ATRIB> ::= <TIPO> <DECL> ";";
<DECL> ::= ID "=" <EXP> | ID | ID"," <DECL> | ID "=" <EXP>"," <DECL>;

<EXP> ::= <EXP> <OP> <EXP>
	| "(" <EXP> ")"
	| ID | INT;
<OP> ::= "+"  | "*"  | "-"  | "/";
<TIPO> ::= "int"  | "float"  | "char"  | "string";


//Leitura de dados
<READ> ::= READ_INPUT "(" ID ")" ";";

//escrita de dados
<WRITE> ::= PRINT_OUTPUT "(" <WRITE_CONTENT> ")" ";" ;
<WRITE_CONTENT> ::= STRING | CHAR | ID | <EXP>;

